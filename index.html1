<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>สุขสันต์วันเกิด</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700&family=Sarabun:wght@300;400;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#F4EBFF;
    --sky-1:#0E0722;
    --sky-2:#1E0F3E;
    --pink:#FF7AA8;
    --pink-soft:#FFB6CE;
    --gold:#FFD98A;
    --card:#2A1750;
    --line: rgba(244,235,255,0.18);
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0;
    font-family:'Sarabun',sans-serif;
    background:radial-gradient(ellipse at 50% 0%, var(--sky-2), var(--sky-1) 70%);
    color:var(--ink);
    overflow:hidden;
    -webkit-tap-highlight-color:transparent;
  }
  .stage{
    position:relative;
    width:100%;
    height:100vh;
    max-width:480px;
    margin:0 auto;
    overflow:hidden;
  }
  canvas#stars{
    position:absolute; inset:0; width:100%; height:100%; z-index:0;
  }
  .scene{
    position:absolute; inset:0;
    display:none;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:32px 28px;
    text-align:center;
    z-index:2;
    animation: fadeIn .6s ease;
  }
  .scene.active{ display:flex; }
  @keyframes fadeIn{ from{opacity:0; transform:translateY(10px)} to{opacity:1; transform:none} }

  .eyebrow{
    font-family:'Baloo 2',sans-serif;
    font-size:14px;
    color:var(--pink-soft);
    letter-spacing:.02em;
    margin:0 0 6px;
  }
  h1{
    font-family:'Baloo 2',sans-serif;
    font-weight:700;
    font-size:clamp(28px,7vw,40px);
    line-height:1.15;
    margin:0 0 14px;
  }
  p.lead{
    font-size:16px;
    line-height:1.7;
    color:var(--ink);
    opacity:.88;
    max-width:34ch;
    margin:0 0 28px;
  }
  .btn{
    font-family:'Baloo 2',sans-serif;
    font-size:16px;
    font-weight:700;
    color:var(--sky-1);
    background:linear-gradient(180deg,#FFE3B0,var(--gold));
    border:none;
    border-radius:999px;
    padding:14px 34px;
    cursor:pointer;
    box-shadow:0 6px 0 #C99A47, 0 10px 24px rgba(0,0,0,.35);
    transition:transform .15s ease;
  }
  .btn:active{ transform:translateY(4px); box-shadow:0 2px 0 #C99A47; }
  .btn.ghost{
    background:transparent;
    color:var(--ink);
    box-shadow:none;
    border:1px solid var(--line);
    padding:12px 28px;
  }

  .progress{
    position:absolute; left:24px; right:24px; bottom:22px; z-index:3;
    height:3px; border-radius:3px; background:var(--line); overflow:hidden;
  }
  .progress i{
    display:block; height:100%; width:0%;
    background:linear-gradient(90deg,var(--pink),var(--gold));
    transition:width .5s ease;
  }

  /* --- Cake scene --- */
  .cake-wrap{ position:relative; width:180px; height:170px; margin:0 auto 22px; }
  .cake{ position:absolute; bottom:0; width:100%; }
  .cake .tier{ background:#F9E1C8; border:3px solid #3A2350; border-radius:10px; }
  .cake .tier1{ height:46px; width:100%; position:absolute; bottom:0; background:#EFC9E9; }
  .cake .tier2{ height:38px; width:78%; left:11%; position:absolute; bottom:44px; background:#F9E1C8; }
  .candle{
    position:absolute; bottom:80px; width:6px; height:34px; background:var(--gold);
    border-radius:2px; left:50%; transform:translateX(-50%);
  }
  .flame{
    position:absolute; top:-16px; left:50%; transform:translateX(-50%);
    width:12px; height:18px; border-radius:50% 50% 50% 50%/60% 60% 40% 40%;
    background:radial-gradient(circle at 50% 70%, #FFF3B0, #FF9B3D 70%);
    animation: flicker 1.1s infinite ease-in-out;
    filter:drop-shadow(0 0 6px #FFB84D);
  }
  .flame.out{ animation:none; opacity:0; transition:opacity .4s ease; }
  @keyframes flicker{ 0%,100%{transform:translateX(-50%) scale(1)} 50%{transform:translateX(-48%) scale(0.9) rotate(-4deg)} }
  .smoke{
    position:absolute; top:-16px; left:50%; width:3px; height:0px; background:rgba(255,255,255,.5);
    border-radius:3px; opacity:0;
  }
  .smoke.show{ animation: smokeUp 1.4s ease forwards; }
  @keyframes smokeUp{ 0%{height:0; opacity:.7; transform:translate(-50%,0)} 100%{height:60px; opacity:0; transform:translate(-30%,-60px)} }

  /* --- Tree scene --- */
  .tree-wrap{ position:relative; width:220px; height:220px; margin:0 auto 10px; }
  .trunk{
    position:absolute; bottom:0; left:50%; width:10px; height:70px; transform:translateX(-50%);
    background:linear-gradient(180deg,var(--pink-soft),var(--pink));
    border-radius:6px;
    transform-origin:bottom center;
    animation: grow 1s ease forwards;
  }
  @keyframes grow{ from{ transform:translateX(-50%) scaleY(0);} to{ transform:translateX(-50%) scaleY(1);} }
  .heart-leaf{
    position:absolute; font-size:16px; opacity:0; animation: pop .5s ease forwards;
  }
  @keyframes pop{ from{opacity:0; transform:scale(.2)} to{opacity:1; transform:scale(1)} }

  /* --- Gallery --- */
  .gallery{
    display:flex; gap:12px; overflow-x:auto; width:100%; max-width:320px; padding:8px 4px 18px;
    scroll-snap-type:x mandatory;
  }
  .gallery .gallery-item{
    flex:0 0 85%; scroll-snap-align:center;
    background:var(--card); border:1px solid var(--line); border-radius:16px;
    height:220px; overflow:hidden; display:flex; align-items:center; justify-content:center;
  }
  .gallery .gallery-item img{
    width:100%; height:100%; object-fit:cover; display:block;
  }

  /* --- Match game --- */
  .grid{
    display:grid; grid-template-columns:repeat(4,1fr); gap:10px;
    width:100%; max-width:300px; margin:0 auto 18px;
  }
  .card{
    aspect-ratio:1/1; border-radius:14px; background:var(--card);
    display:flex; align-items:center; justify-content:center;
    font-size:24px; cursor:pointer; border:1px solid var(--line);
    transform-style:preserve-3d; transition:transform .35s ease, background .2s;
    user-select:none;
  }
  .card.flipped{ background:#3B2270; }
  .card.matched{ background:transparent; border-color:transparent; opacity:.55; cursor:default; }
  .card .face{ display:none; }
  .card.flipped .face, .card.matched .face{ display:block; }
  .card:not(.flipped):not(.matched) .back{ display:block; color:var(--pink-soft); }
  .status{ font-size:14px; color:var(--pink-soft); margin-bottom:14px; min-height:18px; }

  .final-hearts{ font-size:38px; margin-bottom:6px; }
</style>
</head>
<body>
<div class="stage">
  <canvas id="stars"></canvas>

  <!-- Scene 0: Landing -->
  <section class="scene active" data-scene="0">
    <p class="eyebrow">ของขวัญจาก ✦ เพื่อนของเธอ</p>
    <h1>สุขสันต์วันเกิดนะ<br>เจ้าตัวแสบ 🎈</h1>
    <p class="lead">ของขวัญชิ้นนี้ไม่ได้มีแค่คำว่า “สุขสันต์วันเกิด” แต่มีความทรงจำของเราสองคนอยู่ข้างในด้วย</p>
    <button class="btn" onclick="goTo(1)">เปิดของขวัญ 🎁</button>
  </section>

  <!-- Scene 1: Message -->
  <section class="scene" data-scene="1">
    <p class="eyebrow">ข้อความจากใจ</p>
    <h1>ขอบคุณที่เกิดมานะ</h1>
    <p class="lead">ปีนี้ก็เป็นอีกปีที่เธอเก่งขึ้น อดทนขึ้น และน่ารักขึ้นเหมือนเดิม<br>ขอให้ปีใหม่นี้มีแต่เรื่องดี ๆ เข้ามาเยอะ ๆ นะ 🩵</p>
    <button class="btn" onclick="goTo(2)">ต่อไป →</button>
  </section>

  <!-- Scene 2: Blow candle -->
  <section class="scene" data-scene="2">
    <p class="eyebrow">🎂 เป่าเทียนวันเกิด!</p>
    <div class="cake-wrap" id="cakeWrap">
      <div class="candle">
        <div class="smoke" id="smoke"></div>
        <div class="flame" id="flame"></div>
      </div>
      <div class="cake">
        <div class="tier tier2"></div>
        <div class="tier tier1"></div>
      </div>
    </div>
    <p class="lead" id="cakeText">กดปุ่มด้านล่างเพื่อเป่าเทียน แล้วอย่าลืมอธิษฐานด้วยล่ะ</p>
    <button class="btn" id="blowBtn" onclick="blowCandle()">เป่าเทียน 🌬️</button>
  </section>

  <!-- Scene 3: Heart tree -->
  <section class="scene" data-scene="3">
    <p class="eyebrow">ต้นไม้แห่งความทรงจำ</p>
    <div class="tree-wrap" id="treeWrap">
      <div class="trunk"></div>
    </div>
    <p class="lead">ทุกใบคือช่วงเวลาเล็ก ๆ ที่เรามีร่วมกัน</p>
    <button class="btn" onclick="goTo(4)">ต่อไป →</button>
  </section>

  <!-- Scene 4: Gallery (ปรับเปลี่ยนส่วนนี้) -->
  <section class="scene" data-scene="4">
    <p class="eyebrow">อัลบั้มความทรงจำ</p>
    <h1 style="font-size:22px">เลื่อนดูกันได้เลย 📸</h1>
    <div class="gallery">
      <div class="gallery-item"><img src="photo1.jpg" alt="รูปที่ 1"></div>
      <div class="gallery-item"><img src="photo2.jpg" alt="รูปที่ 2"></div>
      <div class="gallery-item"><img src="photo3.jpg" alt="รูปที่ 3"></div>
      <div class="gallery-item"><img src="photo4.jpg" alt="รูปที่ 4"></div>
    </div>
    <button class="btn" onclick="goTo(5)">ไปเล่นเกมกัน →</button>
  </section>

  <!-- Scene 5: Memory match -->
  <section class="scene" data-scene="5">
    <p class="eyebrow">🧩 จับคู่ภาพความทรงจำ</p>
    <div class="status" id="matchStatus">แตะการ์ดเพื่อเปิดทีละ 2 ใบ</div>
    <div class="grid" id="grid"></div>
    <button class="btn ghost" id="nextAfterGame" style="display:none" onclick="goTo(6)">ต่อไป →</button>
  </section>

  <!-- Scene 6: Final -->
  <section class="scene" data-scene="6">
    <div class="final-hearts">💗🎉💗</div>
    <h1>Happy Birthday!</h1>
    <p class="lead">หวังว่าของขวัญชิ้นนี้จะทำให้เธอยิ้มได้นะ<br>รักเธอที่สุดเลย</p>
    <button class="btn ghost" onclick="goTo(0)">เล่นอีกครั้ง ⟲</button>
  </section>

  <div class="progress"><i id="bar"></i></div>
</div>

<script>
/* ---------- background stars ---------- */
const canvas = document.getElementById('stars');
const ctx = canvas.getContext('2d');
function resize(){
  canvas.width = canvas.clientWidth * devicePixelRatio;
  canvas.height = canvas.clientHeight * devicePixelRatio;
}
window.addEventListener('resize', resize); resize();
const stars = Array.from({length:70}, () => ({
  x: Math.random(), y: Math.random(), r: Math.random()*1.6+0.4,
  s: Math.random()*0.02+0.005, p: Math.random()*Math.PI*2
}));
function drawStars(t){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  stars.forEach(st=>{
    const alpha = 0.4 + 0.6*Math.sin(t*st.s + st.p);
    ctx.fillStyle = `rgba(255,246,225,${Math.max(0,alpha)})`;
    ctx.beginPath();
    ctx.arc(st.x*canvas.width, st.y*canvas.height, st.r*devicePixelRatio, 0, 7);
    ctx.fill();
  });
  requestAnimationFrame(drawStars);
}
requestAnimationFrame(drawStars);

/* ---------- scene navigation ---------- */
const total = 7;
function goTo(n){
  document.querySelectorAll('.scene').forEach(s=>s.classList.remove('active'));
  document.querySelector(`.scene[data-scene="${n}"]`).classList.add('active');
  document.getElementById('bar').style.width = (n/(total-1)*100)+'%';
  if(n===3) growTree();
  if(n===5) initGame();
}

/* ---------- candle blow ---------- */
let blown = false;
function blowCandle(){
  if(blown) return;
  blown = true;
  document.getElementById('flame').classList.add('out');
  document.getElementById('smoke').classList.add('show');
  document.getElementById('cakeText').textContent = 'อธิษฐานเสร็จแล้วใช่ไหม? ขอให้เป็นจริงนะ 🌟';
  document.getElementById('blowBtn').textContent = 'ต่อไป →';
  document.getElementById('blowBtn').onclick = ()=>goTo(3);
}

/* ---------- heart tree ---------- */
let treeGrown = false;
function growTree(){
  if(treeGrown) return;
  treeGrown = true;
  const wrap = document.getElementById('treeWrap');
  const hearts = ['💗','💕','💖','💓'];
  const positions = [
    [40,30],[70,15],[100,10],[130,15],[160,30],
    [55,55],[85,40],[115,40],[145,55],
    [70,70],[110,70],[95,95]
  ];
  positions.forEach((p,i)=>{
    const el = document.createElement('div');
    el.className = 'heart-leaf';
    el.textContent = hearts[i % hearts.length];
    el.style.left = p[0]+'px';
    el.style.bottom = p[1]+'px';
    el.style.animationDelay = (0.8 + i*0.08)+'s';
    wrap.appendChild(el);
  });
}

/* ---------- memory match game ---------- */
let gameInit = false;
function initGame(){
  if(gameInit) return;
  gameInit = true;
  const emojis = ['🎂','🎈','🎁','🌟','🩷','🎉'];
  let deck = [...emojis, ...emojis];
  deck.sort(()=>Math.random()-0.5);
  const grid = document.getElementById('grid');
  let first=null, second=null, lock=false, matches=0;
  deck.forEach((val,i)=>{
    const c = document.createElement('div');
    c.className='card';
    c.innerHTML = `<span class="face">${val}</span><span class="back">✦</span>`;
    c.onclick = ()=>{
      if(lock || c.classList.contains('flipped') || c.classList.contains('matched')) return;
      c.classList.add('flipped');
      if(!first){ first = c; return; }
      second = c;
      lock = true;
      const same = first.querySelector('.face').textContent === second.querySelector('.face').textContent;
      setTimeout(()=>{
        if(same){
          first.classList.add('matched'); second.classList.add('matched');
          matches++;
          document.getElementById('matchStatus').textContent = `จับคู่แล้ว ${matches}/${emojis.length} 💗`;
          if(matches===emojis.length){
            document.getElementById('matchStatus').textContent = 'เก่งมาก! จับคู่ครบแล้ว 🎉';
            document.getElementById('nextAfterGame').style.display='inline-block';
          }
        } else {
          first.classList.remove('flipped'); second.classList.remove('flipped');
        }
        first=null; second=null; lock=false;
      }, 700);
    };
    grid.appendChild(c);
  });
}
</script>
</body>
  </html>
